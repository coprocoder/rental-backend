{
  // Сборка в прод: рабочий код и служебные скрипты, без тестов.
  //
  // ⚠️ `rootDir: "."`, чтобы в выход попали и `src/`, и `scripts/`:
  // миграции, сеятель и воркер написаны на TypeScript и используют
  // алиас `~`. Иначе в прод-образ пришлось бы тащить `tsx` и
  // компилировать их при каждом запуске.
  //
  // ⚠️ Выход поэтому `dist/src/main.js`, а не `dist/main.js` — на это
  // и настроен `npm start`. Раньше он указывал на `dist/main.js`,
  // которого не существовало: сборка «проходила», а запустить
  // результат было нельзя.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    // Карты нужны в проде: без них стек в журнале указывает на строку
    // скомпилированного файла, и разбор происшествия начинается с
    // поиска, какой это был исходник.
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/test/**"]
}
