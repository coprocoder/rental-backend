{
  "name": "@rental/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch": "depcruise --config .dependency-cruiser.cjs src",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "valibot": "^0.42.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.11.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
