# Адрес БД приложения. Роль БЕЗ BYPASSRLS — иначе RLS перестаёт
# защищать, и вся конструкция «инварианты в БД» теряет смысл.
DATABASE_URL=postgres://rental:rental@localhost:55432/rental

# Адрес БД фоновых процессов. Отдельная роль с BYPASSRLS: воркеры
# работают поперёк тенантов по определению. Локально можно не задавать —
# возьмётся DATABASE_URL; в проде роль обязана быть отдельной.
# DATABASE_URL_WORKER=postgres://rental_worker:...@localhost:55432/rental

PORT=3200
LOG_LEVEL=info
SERVICE_NAME=rental-api

# Origins фронта через запятую. Пустое значение означает «тот же
# origin», а НЕ «всем можно».
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
