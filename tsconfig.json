{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,

    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    // ⚠️ Алиас `@rental/shared/*` вёл на `../rental/shared/*` — каталог,
    // удалённый вместе с Nuxt, и ни одного импорта через него не было.
    // Убран: путь в конфигурации, ведущий в никуда, читается как
    // разрешение так импортировать.
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
